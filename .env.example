# 不填密钥时，组会整理、论文摘录和对话使用可核对的本地规则，不会假装已经调用云端模型。
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_VISION_MODEL=qwen3-vl-plus
PORT=4320
DATABASE_PATH=

# Offer岛个人 API key；留空时使用共享只读测试 key，可能受每日额度限制。
OFFERDAO_API_KEY=

# 评审云部署：默认关闭，必须同时配置公开 HTTPS 地址、账号、密码和持久数据库路径。
REVIEW_MODE=false
PUBLIC_ORIGIN=
REVIEW_USER=
REVIEW_PASSWORD=
